# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO HỆ THỐNG iBanking MICROSERVICES (TDTU SOA)
# Chạy file setup.bat (hoặc setup.ps1) để tự động sinh file .env với secrets an toàn
# ==============================================================================

# 1. Cơ sở dữ liệu MySQL (Root credentials dành cho bootstrap)
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PORT=3306

# 2. Database Service Accounts (Database Ownership - Phân quyền tối thiểu)
USER_DB_USER=ibanking_user_app
USER_DB_PASSWORD=CHANGE_ME_USER_DB_PASSWORD

TUITION_DB_USER=ibanking_tuition_app
TUITION_DB_PASSWORD=CHANGE_ME_TUITION_DB_PASSWORD

PAYMENT_DB_USER=ibanking_payment_app
PAYMENT_DB_PASSWORD=CHANGE_ME_PAYMENT_DB_PASSWORD

# 3. Secret keys xác thực (Fail-fast: Bắt buộc cấu hình đầy đủ)
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY

# 4. Cấu hình CORS (Chỉ cho phép Frontend hợp lệ truy cập API Gateway)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 5. Cấu hình Redis (OTP Cache & Distributed Lock)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
OTP_EXPIRE_SECONDS=300

# 6. Cấu hình SMTP Gửi Email OTP & Biên lai
# Chế độ 1: Mailpit (Mặc định cho Local Demo - Zero-config, xem tại http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@ibanking.tdtu.edu.vn
SMTP_FROM_NAME="iBanking TDTU Support"
USE_TLS=false

# Chế độ 2: Gmail SMTP (Tùy chọn: Khi muốn gửi OTP tới hộp thư thật)
# Để bật: Bỏ comment các dòng bên dưới (lưu ý tạo Gmail App Password 16 chữ số)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# USE_TLS=true

# 7. Service Ports
API_GATEWAY_PORT=8000
USER_SERVICE_PORT=8001
TUITION_SERVICE_PORT=8002
PAYMENT_SERVICE_PORT=8003
NOTIFICATION_SERVICE_PORT=8004
