# ========================================================
# BIẾN MÔI TRƯỜNG MẪU CHO HỆ THỐNG iBanking MICROSERVICES
# Chạy file setup.bat để tự động khởi tạo file .env với secrets an toàn
# ========================================================

# MySQL Root & Ports
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PORT=3306

# Database Service Accounts (Data Ownership cho từng microservice)
USER_DB_USER=ibanking_user_app
USER_DB_PASSWORD=CHANGE_ME_USER_DB_PASSWORD
TUITION_DB_USER=ibanking_tuition_app
TUITION_DB_PASSWORD=CHANGE_ME_TUITION_DB_PASSWORD
PAYMENT_DB_USER=ibanking_payment_app
PAYMENT_DB_PASSWORD=CHANGE_ME_PAYMENT_DB_PASSWORD

# Secret key cho mã hóa JWT (Bắt buộc cấu hình qua biến môi trường)
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Khóa bí mật giao tiếp nội bộ giữa các microservices (Bắt buộc)
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_SECRET_KEY

# Cấu hình OTP
OTP_EXPIRE_SECONDS=300

# Cấu hình Redis (Distributed Lock & Caching OTP)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Cấu hình SMTP Gửi Email (Gmail App Password hoặc Mail Server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=no-reply@ibanking.tdtu.edu.vn
SMTP_FROM_NAME="iBanking TDTU Support"
USE_TLS=true

# Service Ports
API_GATEWAY_PORT=8000
USER_SERVICE_PORT=8001
TUITION_SERVICE_PORT=8002
PAYMENT_SERVICE_PORT=8003
NOTIFICATION_SERVICE_PORT=8004
