# ========================================================
# BIẾN MÔI TRƯỜNG TỔNG QUAN CHO HỆ THỐNG iBanking MICROSERVICES
# ========================================================

# MySQL Root & Ports
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306

# Secret key cho mã hóa JWT
JWT_SECRET_KEY=ibanking-super-secret-key-tdtu-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Khóa bí mật giao tiếp nội bộ giữa các microservices
INTERNAL_API_KEY=ibanking-internal-secret-token-2026

# Cấu hình OTP
OTP_EXPIRE_SECONDS=300

# Cấu hình Redis (Distributed Lock & Caching OTP)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Cấu hình Mailpit (Web UI xem mail tại http://localhost:8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Service Ports
API_GATEWAY_PORT=8000
USER_SERVICE_PORT=8001
TUITION_SERVICE_PORT=8002
PAYMENT_SERVICE_PORT=8003
NOTIFICATION_SERVICE_PORT=8004
