# ========================================================
# BIẾN MÔI TRƯỜNG MẪU - iBanking MICROSERVICES
# Copy file này thành .env và điền thông tin thực tế của bạn
# ========================================================

# MySQL Root & Ports
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306

# Secret key cho mã hóa JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Khóa bí mật giao tiếp nội bộ giữa các microservices
INTERNAL_API_KEY=your-internal-secret-token-change-this

# Cấu hình OTP
OTP_EXPIRE_SECONDS=300

# Cấu hình Redis (Distributed Lock & Caching OTP)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Cấu hình Gửi Email OTP (Gmail SMTP hoặc Mail Server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="iBanking TDTU Support"
USE_TLS=true

# Service Ports
API_GATEWAY_PORT=8000
USER_SERVICE_PORT=8001
TUITION_SERVICE_PORT=8002
PAYMENT_SERVICE_PORT=8003
NOTIFICATION_SERVICE_PORT=8004
