# ========================================================
# Git Ignore - iBanking Microservices (SOA - TDTU)
# ========================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Caches
.pytest_cache/
.coverage
htmlcov/
.cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# (File .env và cấu hình đã được cho phép commit để nhóm làm chung chạy ngay)
*.pem
*.key

# Temporary logs
*.log
logs/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# AI Agent & Antigravity IDE local cache
.agents/
.gemini/
